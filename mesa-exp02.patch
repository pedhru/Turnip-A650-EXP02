+/* Keep the stack bounded and retain the merge path for large submissions.
+ * KGSL consumes the pointed-to payloads during the submission ioctl, so the
+ * FD syncpoints borrow their descriptors; they must not be closed here.
+ */
+#define KGSL_NATIVE_SYNCPOINT_LIMIT 16
+
+static bool
+kgsl_build_native_syncpoints(const struct kgsl_syncobj *const *syncobjs,
+                             uint32_t count,
+                             struct kgsl_command_syncpoint *points,
+                             struct kgsl_cmd_syncpoint_timestamp *timestamps,
+                             struct kgsl_cmd_syncpoint_fence *fences,
+                             uint32_t *point_count)
+{
+   *point_count = 0;
+   if (count > KGSL_NATIVE_SYNCPOINT_LIMIT)
+      return false;
+
+   for (uint32_t i = 0; i < count; i++) {
+      const struct kgsl_syncobj *s = syncobjs[i];
+      uint32_t n = *point_count;
+      switch (s->state) {
+      case KGSL_SYNCOBJ_STATE_SIGNALED:
+         continue;
+      case KGSL_SYNCOBJ_STATE_TS: {
+         bool merged = false;
+         for (uint32_t j = 0; j < n; j++) {
+            if (points[j].type == KGSL_CMD_SYNCPOINT_TYPE_TIMESTAMP &&
+                timestamps[j].context_id == s->queue->msm_queue_id) {
+               timestamps[j].timestamp = max_ts(timestamps[j].timestamp, s->timestamp);
+               merged = true;
+               break;
+            }
+         }
+         if (merged)
+            continue;
+         timestamps[n] = (struct kgsl_cmd_syncpoint_timestamp) {
+            .context_id = s->queue->msm_queue_id,
+            .timestamp = s->timestamp,
+         };
+         points[n] = (struct kgsl_command_syncpoint) {
+            .priv = reinterpret_cast<uintptr_t>(&timestamps[n]),
+            .size = sizeof(timestamps[n]),
+            .type = KGSL_CMD_SYNCPOINT_TYPE_TIMESTAMP,
+         };
+         break;
+      }
+      case KGSL_SYNCOBJ_STATE_FD: {
+         bool duplicate = false;
+         for (uint32_t j = 0; j < n; j++) {
+            if (points[j].type == KGSL_CMD_SYNCPOINT_TYPE_FENCE &&
+                fences[j].fd == s->fd) {
+               duplicate = true;
+               break;
+            }
+         }
+         if (duplicate)
+            continue;
+         fences[n] = (struct kgsl_cmd_syncpoint_fence) { .fd = s->fd };
+         points[n] = (struct kgsl_command_syncpoint) {
+            .priv = reinterpret_cast<uintptr_t>(&fences[n]),
+            .size = sizeof(fences[n]),
+            .type = KGSL_CMD_SYNCPOINT_TYPE_FENCE,
+         };
+         break;
+      }
+      default:
+         /* Pending waits must be handled by the existing merge path. */
+         *point_count = 0;
+         return false;
+      }
+      ++*point_count;
+   }
+   return true;
 }
 
